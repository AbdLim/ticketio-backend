# Hedera Configuration Mapping:
# 
# From Hedera Portal → Environment Variable:
# ACCOUNT ID → HEDERA_OPERATOR_ID (format: 0.0.123456)
# DER ENCODED PRIVATE KEY → HEDERA_OPERATOR_KEY (long hex string)
# 
# DO NOT USE:
# - EVM ADDRESS (this is for Ethereum compatibility)
# - HEX ENCODED PRIVATE KEY (different format)
# - DER ENCODED PUBLIC KEY (not needed for transactions)

HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.YOUR_ACCOUNT_ID
HEDERA_OPERATOR_KEY=YOUR_DER_ENCODED_PRIVATE_KEY_HERE
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# Example:
# HEDERA_OPERATOR_ID=0.0.6863379
# HEDERA_OPERATOR_KEY=302e020100300506032b657004220420a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456